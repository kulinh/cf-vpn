# Secrets & runtime state — never commit any env file except the *.example templates
.env
.env.local
*.env
!*.env.example
/etc/cfvpn/
/etc/cfvpn/*.env
/var/lib/cfvpn/subscriptions/
/var/lib/cfvpn/state/
cfvpn-backups/
/root/cfvpn-backups/
bin/

# Editor
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
.healthcheck.state

# Local worktrees
.worktrees/
.worktree-backups/

# Frontend build and dependency outputs
panel/web/node_modules/
panel/web/dist/
panel/web/.vite/

# Worker build and dependency outputs
panel/worker/node_modules
panel/worker/.wrangler/

# Wrangler / Playwright local caches
.wrangler/
.playwright-mcp/

# Local Go binary outputs (built at repo root)
/cfvpn-agent
/cfvpnctl

# vitest cache accidentally created under src/
panel/worker/src/node_modules/

# python caches from scripts/tests
__pycache__/
