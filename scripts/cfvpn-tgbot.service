# /etc/systemd/system/cfvpn-tgbot.service — Telegram control bot, VNM-01 only.
# Install:
#   install -m 0755 bin/cfvpn-tgbot /usr/local/bin/cfvpn-tgbot
#   install -m 644 scripts/cfvpn-tgbot.service /etc/systemd/system/cfvpn-tgbot.service
#   systemctl daemon-reload && systemctl enable --now cfvpn-tgbot
#
# Deliberately NOT part of cfvpnctl's canonical unit set: it belongs to this
# box only (it drives the Tailscale policy with the OAuth client in
# /etc/cfvpn/tailscale-oauth.env), so `cfvpnctl reconcile-units` on the fleet
# must neither create nor remove it.
[Unit]
Description=cfvpn Telegram control bot (@rwl_vpn_bot, long polling)
After=network-online.target tailscaled.service
Wants=network-online.target
# Telegram outages must not be fatal; keep retrying forever.
StartLimitIntervalSec=0

[Service]
Type=simple
# The token and chat id come from the fleet-probe env; tgbot.env is optional
# and can override them.
EnvironmentFile=/etc/cfvpn/fleet-probe.env
EnvironmentFile=-/etc/cfvpn/tgbot.env
ExecStart=/usr/local/bin/cfvpn-tgbot
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
