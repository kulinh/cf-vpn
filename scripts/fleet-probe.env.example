# /etc/cfvpn/fleet-probe.env — read by scripts/fleet-probe.py (mode 600).
# Copy: install -m 600 scripts/fleet-probe.env.example /etc/cfvpn/fleet-probe.env

# The user's subscription URL (base64 body). Token from D1 users.sub_token.
SUB_URL=https://cp.rwl265.com/sub/<sub_token>

# Telegram bot that posts alerts. The token lives only in the Worker's
# secrets, so the operator pastes it here. Empty = alerts go to stderr only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1003806233980

# Alert after this many consecutive failed runs of one route (3-hour cron
# => 2 means ~6 hours down before the first message; set 1 to alert on the first miss).
FAIL_THRESHOLD=2

# Name of this vantage point in the alert header (default: hostname). The probe
# runs on VNM-01 (home ISP view) and JPY-03 (datacenter view): a route failing
# from both is a dead node, from one only is that path.
#PROBE_LABEL=vnm-01

# Defaults, override only if needed.
#STATE_FILE=/var/lib/cfvpn/fleet-probe.state
#LOG_FILE=/var/log/cfvpn-fleet-probe.log
#XRAY_BIN=/usr/local/bin/xray
#HYSTERIA_BIN=/usr/local/bin/hysteria

# Auto-delete of alert messages: queued here, deleted by cfvpn-tgbot after
# TELEGRAM_MESSAGE_TTL_HOURS. Set TELEGRAM_TTL_DIR= (empty) to keep messages.
#TELEGRAM_TTL_DIR=/var/lib/cfvpn/tg-ttl
#TELEGRAM_MESSAGE_TTL_HOURS=24
